# Choose ONE provider, or leave all blank to run fully offline/deterministic
# (no LLM calls at all; key_findings use the rule engine's own sentences).
LLM_PROVIDER=auto           # auto | anthropic | groq | openai_compatible | none
                            # "auto" picks the first of GROQ_API_KEY / ANTHROPIC_API_KEY /
                            # OPENAI_API_KEY that is set below, else falls back to none.

# --- Groq (recommended free/low-cost option) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Any other OpenAI-compatible endpoint (Together, Ollama, etc.) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Frontend -> backend
CLAIM_API_URL=http://localhost:8000
